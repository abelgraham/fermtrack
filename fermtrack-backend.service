[Unit]
Description=FermTrack Backend API
After=network.target

[Service]
Type=simple
User=DEPLOY_USER
WorkingDirectory=/home/DEPLOY_USER/fermtrack/backend
Environment=PYTHONPATH=/home/DEPLOY_USER/fermtrack/backend
ExecStart=/usr/bin/python3 /home/DEPLOY_USER/fermtrack/backend/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target